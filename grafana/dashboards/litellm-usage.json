{
  "uid": "llm-litellm-usage",
  "title": "LiteLLM — Usage équipe dev",
  "description": "Vue gateway : charge et latence par team / utilisateur / clé, santé des déploiements.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "llm",
    "iag"
  ],
  "timezone": "Europe/Paris",
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "team",
        "label": "Team",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-llm"
        },
        "query": {
          "query": "label_values({__name__=~\"litellm_proxy_total_requests_metric(_total)?\"}, team_alias)",
          "refId": "v"
        },
        "definition": "label_values({__name__=~\"litellm_proxy_total_requests_metric(_total)?\"}, team_alias)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "user",
        "label": "Utilisateur",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-llm"
        },
        "query": {
          "query": "label_values({__name__=~\"litellm_proxy_total_requests_metric(_total)?\",team_alias=~\"$team\"}, user)",
          "refId": "v"
        },
        "definition": "label_values({__name__=~\"litellm_proxy_total_requests_metric(_total)?\",team_alias=~\"$team\"}, user)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "key",
        "label": "Clé API",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-llm"
        },
        "query": {
          "query": "label_values({__name__=~\"litellm_proxy_total_requests_metric(_total)?\",team_alias=~\"$team\",user=~\"$user\"}, api_key_alias)",
          "refId": "v"
        },
        "definition": "label_values({__name__=~\"litellm_proxy_total_requests_metric(_total)?\",team_alias=~\"$team\",user=~\"$user\"}, api_key_alias)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Vue d'ensemble (période sélectionnée)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requêtes",
      "description": "",
