        "type": "prometheus",
        "uid": "prom-llm"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-llm"
          },
          "expr": "sum(increase({__name__=~\"litellm_proxy_total_requests_metric(_total)?\",team_alias=~\"$team\",user=~\"$user\",api_key_alias=~\"$key\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
