{
  "uid": "llm-vllm-engines",
  "title": "vLLM — Moteurs (stacks GB10)",
  "description": "Vue moteur : file d'attente, KV cache, préemptions, latences. Base de décision tuning vs restriction.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "llm",
    "iag"
  ],
  "timezone": "Europe/Paris",
  "refresh": "1m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "provider",
        "label": "Stack",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prom-llm"
        },
        "query": {
          "query": "label_values({__name__=~\"vllm:num_requests_running\"}, provider)",
          "refId": "v"
        },
        "definition": "label_values({__name__=~\"vllm:num_requests_running\"}, provider)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 19,
      "type": "row",
      "title": "Synthèse saturation (période sélectionnée)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Pic requêtes en cours",
      "description": "Pire valeur parmi les stacks sélectionnées",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-llm"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prom-llm"
          },
          "expr": "max(max_over_time(sum by (provider) ({__name__=~\"vllm:num_requests_running\",provider=~\"$provider\"})[$__range:1m]))",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 21,
      "type": "stat",
      "title": "Pic requêtes en attente",
