# --- Exposition ---
# Adresse d'écoute de Grafana et Prometheus. 127.0.0.1 = accès local / tunnel SSH uniquement.
# Mettre l'IP de l'interface d'admin pour un accès réseau (jamais 0.0.0.0 sur un réseau partagé).
BIND_ADDR=127.0.0.1

# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
GF_PORT=3000

# --- Prometheus ---
PROM_PORT=9090
PROM_RETENTION=120d   # mois d'observation + mois après les mesures, pour comparer

# --- Postgres de LiteLLM (optionnel mais recommandé : données exactes par requête) ---
# Utiliser un rôle en LECTURE SEULE (voir README).
LITELLM_PG_HOST=10.0.0.10:5432
LITELLM_PG_DB=litellm
LITELLM_PG_USER=grafana_ro
LITELLM_PG_PASSWORD=change-me
LITELLM_PG_SSLMODE=disable

# --- Rapport ---
# SLO utilisés pour le diagnostic automatique (secondes)
SLO_TTFT_P95=2.0
# Sur GB10, un ITL p95 ~140 ms est le plafond de décodage du modèle (bande passante mémoire),
# pas un symptôme de saturation : 0.2 s est plus réaliste qu'un 0.1 s « académique ».
# La règle « batch trop gros » n'est de toute façon déclenchée qu'avec une concurrence réelle.
SLO_ITL_P95=0.2
# Remplace les identifiants des utilisateurs par user-01, user-02... dans le rapport (défaut : oui)
ANONYMIZE_USERS=true
# Équipes et alias de clés sans usage réel, exclus des KPI et des totaux.
# Le health-check interne de LiteLLM (health/liveliness) et la clé de la sonde témoin
# gonflent artificiellement les compteurs « requêtes » et « utilisateurs actifs ».
EXCLUDE_TEAMS=litellm-internal-health-check
EXCLUDE_KEY_ALIASES=canary
# Analyse « gros prompts vs petites requêtes » (tokens d'entrée)
SMALL_PROMPT_TOKENS=8000
LARGE_PROMPT_TOKENS=100000

# --- Sonde témoin (service canary) ---
# nom=url_openai[|modèle] séparés par des virgules ; sans modèle, le 1er de /models est utilisé.
# Passer par la gateway avec une clé dédiée « canary » mesure l'expérience utilisateur complète ;
# viser chaque master vLLM isole l'effet de chaque stack.
#CANARY_TARGETS=gateway=http://10.0.0.10:4000/v1|mistral-small,stack-a=http://10.0.0.21:8000/v1,stack-b=http://10.0.0.31:8000/v1
CANARY_TARGETS=
CANARY_API_KEY=
#CANARY_KEY_STACK_A=        # clé propre à une cible (vLLM --api-key), sinon CANARY_API_KEY
CANARY_INTERVAL=60

# UID/GID de l'utilisateur hôte propriétaire de ./reports (commande `id`)
# Version de l image reporter (ghcr.io), "latest" par défaut
#LLMOBS_VERSION=latest
HOST_UID=1000
HOST_GID=1000
