# --- Grafana ---
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=change-me
GF_PORT=3000

# --- Prometheus ---
PROM_PORT=9090
PROM_RETENTION=45d

# --- Postgres de LiteLLM (optionnel mais recommandé : données exactes par requête) ---
# Utiliser un rôle en LECTURE SEULE (voir README).
LITELLM_PG_HOST=10.0.0.10:5432
LITELLM_PG_DB=litellm
LITELLM_PG_USER=grafana_ro
LITELLM_PG_PASSWORD=change-me
LITELLM_PG_SSLMODE=disable

# --- Rapport ---
# SLO utilisés pour le diagnostic automatique (secondes)
SLO_TTFT_P95=2.0
SLO_ITL_P95=0.10
# Remplace les identifiants des utilisateurs par user-01, user-02... dans le rapport
ANONYMIZE_USERS=false

# UID/GID de l'utilisateur hôte propriétaire de ./reports (commande `id`)
# Version de l image reporter (ghcr.io), "latest" par défaut
#LLMOBS_VERSION=latest
HOST_UID=1000
HOST_GID=1000
