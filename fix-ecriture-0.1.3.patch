+def test_verdict_pondere_par_la_frequence():
+    # lecture lourde très pénalisante mais rare, bande passante modérée mais fréquente
+    m = pd.concat([minutes(300, 1, 40), minutes(400, 4, 20), minutes(30, 1, 10, prefill=2000)])
